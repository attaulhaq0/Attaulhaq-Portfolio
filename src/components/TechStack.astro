---
import { techStack, projectStackNotes } from '../data/tech-stack';
interface Props { projectSlug?: string }
const { projectSlug } = Astro.props;
const tools = projectSlug ? techStack.flatMap(group => group.tools.filter(tool => tool.projects.includes(projectSlug))) : [];
---

{projectSlug ? tools.length > 0 && <div class="project-tech-stack" aria-label="Project tools">
  <span class="project-tech-label">TOOLS & TECHNOLOGY</span>
  <ul>{tools.map(tool => <li><strong>{tool.name}</strong><span>{tool.context}</span></li>)}</ul>
  <p>{projectStackNotes[projectSlug]}</p>
</div> : <section class="tech-stack-section shell" id="stack" aria-labelledby="stack-title">
  <div class="section-topline"><span class="eyebrow">THE TOOLKIT</span><span class="section-side-note">Code, intelligence and practical workflows.</span></div>
  <div class="tech-stack-heading">
    <div class="tech-stack-intro"><h2 id="stack-title">What I build <em>with.</em></h2><p>Tools for intelligent systems, software and product development, grounded in my earlier game development work.</p></div>
    <div class="tech-stack-art">
      <img src="/images/toolkit-ecosystem.webp" alt="" width="1000" height="667" loading="lazy" decoding="async" />
      <details class="tech-stack-motion">
        <summary>See the toolkit in motion <span aria-hidden="true">▷</span></summary>
        <figure><video controls playsinline muted preload="none" width="1280" height="720" poster="/images/toolkit-motion-poster.webp" aria-label="Illustrated toolkit animation" aria-describedby="toolkit-motion-caption"><source src="/media/toolkit-ecosystem-motion.mp4" type="video/mp4" />Your browser does not support video. <a href="/media/toolkit-ecosystem-motion.mp4">Download the animation</a>.</video><figcaption id="toolkit-motion-caption">A four-second illustration of connected development tools.</figcaption></figure>
      </details>
    </div>
  </div>
  <div class="tech-stack-groups">{techStack.map(group => <article class:list={['tech-stack-group', `stack-accent-${group.accent}`]}>
    <div class="tech-stack-group-heading"><span aria-hidden="true">/{group.index}</span><h3>{group.title}</h3></div>
    <p class="tech-stack-group-description">{group.description}</p>
    <ul class="tech-stack-tools">{group.tools.map(tool => <li><span class="tech-stack-tool-mark" aria-hidden="true">+</span><div><strong>{tool.name}</strong><span>{tool.context}</span></div></li>)}</ul>
  </article>)}</div>
</section>}
<script>
 document.querySelectorAll<HTMLDetailsElement>('.tech-stack-motion').forEach(details => {
  const video = details.querySelector('video');
  if (!video) return;
  const pause = () => video.pause();
  const toggle = () => { if (!details.open) pause(); };
  const visibility = () => { if (document.hidden) pause(); };
  const observer = new IntersectionObserver(entries => { if (!entries[0]?.isIntersecting) pause(); });
  const attach = () => { details.addEventListener('toggle', toggle); document.addEventListener('visibilitychange', visibility); observer.observe(video); };
  const detach = () => { pause(); details.removeEventListener('toggle', toggle); document.removeEventListener('visibilitychange', visibility); observer.disconnect(); };
  attach(); window.addEventListener('pagehide', detach); window.addEventListener('pageshow', attach);
 });
</script>
