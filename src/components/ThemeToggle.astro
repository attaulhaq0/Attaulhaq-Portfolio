---
// Standard control icons remain code-native; the toolkit uses original sculpture art.
---
<button type="button" class="theme-toggle" aria-label="Switch to light mode" aria-pressed="false" hidden>
  <svg class="theme-toggle-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M19.07 4.93l-1.42 1.42M6.35 17.65l-1.42 1.42" /></svg>
  <svg class="theme-toggle-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13.1A9 9 0 0 1 10.9 3.1 9 9 0 1 0 20.9 13.1Z" /></svg>
</button>
<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
  const applyTheme = (theme: 'dark' | 'light') => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#100b18' : '#f3eff9');
    buttons.forEach(button => {
      button.hidden = false;
      button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
      button.setAttribute('aria-pressed', String(theme === 'light'));
    });
    window.dispatchEvent(new CustomEvent('portfolio:themechange', { detail: { theme } }));
  };
  applyTheme(root.dataset.theme === 'light' ? 'light' : 'dark');
  buttons.forEach(button => button.addEventListener('click', () => {
    const theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    applyTheme(theme);
    try { localStorage.setItem('portfolio-theme', theme); } catch { /* Switching still works when storage is unavailable. */ }
  }));
  window.addEventListener('storage', event => {
    if (event.key === 'portfolio-theme') applyTheme(event.newValue === 'light' ? 'light' : 'dark');
  });
  window.addEventListener('pageshow', () => {
    let theme: 'light' | 'dark' = root.dataset.theme === 'light' ? 'light' : 'dark';
    try { const saved = localStorage.getItem('portfolio-theme'); if (saved === 'light' || saved === 'dark') theme = saved; } catch { /* Keep the current palette. */ }
    applyTheme(theme);
  });
</script>
