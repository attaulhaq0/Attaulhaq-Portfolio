---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FieldNotes from '../components/FieldNotes.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Arrow from '../components/Arrow.astro';
import TechStack from '../components/TechStack.astro';
import CareerHighlights from '../components/CareerHighlights.astro';
import HomeGameplay from '../components/HomeGameplay.astro';
import { projects } from '../data/projects';
import { capabilities, experience, site } from '../data/site';
---
<BaseLayout>
  <Hero />
  <section class="intro-section shell" aria-labelledby="intro-title"><div><p class="intro-index">WHAT I DO</p><p class="intro-aside">{site.introduction}</p></div><div><h2 id="intro-title">Gameplay, product direction<br /><span>and AI development.</span></h2><a class="text-link" href="#about">A little about me <Arrow /></a></div></section>
  <section class="work-section paper-section" id="work" aria-labelledby="work-title"><div class="shell">
    <div class="section-topline"><span class="eyebrow">01 / SELECTED WORK</span><span class="section-side-note">Selected projects · 2023–present</span></div>
    <div class="section-heading"><h2 id="work-title">The work.<br /><span class="muted-heading">Behind the experience.</span></h2><p>Gameplay footage, product direction and AI workflows. Explore what I contributed, the decisions behind it and the work in action.</p></div>
    <div class="projects-grid">{projects.filter(project => project.featured).sort((a, b) => (a.homeOrder ?? 99) - (b.homeOrder ?? 99)).map(project => <ProjectCard project={project} />)}</div>
    <article class="fyp-feature"><HomeGameplay name="Digital Dynasty" src="/media/digital-dynasty-gameplay.mp4" poster="/images/home/digital-dynasty-illustration.webp" duration="60-second showcase" /><div class="fyp-feature-copy"><p class="eyebrow">WHERE IT STARTED / UNREAL ENGINE 5</p><h3><a href="/work/survival-game/">Digital Dynasty</a></h3><p>My award-winning Unreal Engine 5 final-year project, connecting exploration, crafting, construction and character progression. Watch the prototype and explore my work behind the systems.</p><a class="text-link" href="/work/survival-game/">Explore the development <Arrow /></a></div></article>
  </div></section>
  <section class="approach-section shell" id="approach" aria-labelledby="approach-title"><div class="capabilities-heading"><span class="eyebrow">02 / WHAT I BRING</span><h2 id="approach-title">Across the interface<br /><em>and the engineering.</em></h2></div><div class="capability-list">{capabilities.map(item => <article class="capability-row"><span class="capability-number">{item.number}</span><h3>{item.title}</h3><div><p>{item.body}</p><ul>{item.tags.map(tag => <li>{tag}</li>)}</ul></div></article>)}</div></section>
  <TechStack />
  <section class="about-section" id="about" aria-labelledby="about-title"><div class="shell about-grid"><div class="about-intro"><span class="eyebrow">03 / A LITTLE CONTEXT</span><h2 id="about-title">I started by<br /><em>building worlds.</em></h2>{site.about.paragraphs.map(paragraph => <p>{paragraph}</p>)}<p class="about-invitation">{site.about.invitation}</p></div><div class="experience-list">{experience.map(item => <article class="experience-item"><div class="experience-dates">{item.dates}<span>{item.location}</span></div><h3>{item.role}</h3><h4>{item.company}</h4><p>{item.description}</p></article>)}</div></div></section>
  <CareerHighlights />
  <FieldNotes />
</BaseLayout>
