---
import { site } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section class:list={['contact-section', { 'contact-compact': compact }]} id="contact" aria-labelledby="contact-title"><div class="shell">
  {!compact && <div class="eyebrow"><span class="status-dot"></span> LET’S CONNECT</div>}
  <div class="contact-grid"><h2 id="contact-title">{compact ? <>Have a project in mind?<br /><em>Let’s talk.</em></> : <>Let’s discuss<br /><em>what you’re building.</em></>}</h2><div>{!compact && <p>{site.contactMessage}</p>}<a class="contact-email" href={`mailto:${site.email}`}><span>{site.email}</span><Arrow /></a><a class="button meeting-button" href={site.calendly} target="_blank" rel="noopener noreferrer">Book a meeting with me <Arrow /></a><p class="meeting-note">30-minute personal conversation · Google Meet.</p></div></div>
</div></section>
<footer class="footer shell"><a class="footer-name" href="/">Sheikh Atta-ul-Haq</a><div class="footer-links"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Arrow /></a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow /></a><a href={site.repository} target="_blank" rel="noopener noreferrer">This site’s source <Arrow /></a><a href="/#top">Back to top ↑</a></div><div class="footer-bottom"><span class="footer-copyright">© {new Date().getFullYear()} Sheikh Atta-ul-Haq <a href="https://www.moncy.dev/" target="_blank" rel="noopener noreferrer">Avatar by Moncy Yohannan</a></span><span>Based in Doha, Qatar <span aria-hidden="true">↗</span></span></div></footer>
<style>
  .footer-bottom { flex-wrap: wrap; }
  .footer-copyright { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 12px; max-width: 100%; }
  .footer-copyright a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 4px; }
  .footer-copyright a:hover { color: var(--mint); }
</style>
