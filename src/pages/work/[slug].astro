---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } })); }
const { project, next } = Astro.props;
---
<BaseLayout title={`${project.name} — Sheikh Atta-ul-Haq`} description={project.summary}>
  <div class="shell case-hero"><a href="/#work" class="back-link">← Back to selected work</a><div class="case-eyebrow eyebrow">CASE STUDY / {project.index} <span>{project.category}</span></div><h1>{project.name}<span class="mint">.</span></h1><p class="case-description">{project.description}</p><dl class="case-facts"><div><dt>MY ROLE</dt><dd>{project.role}</dd></div><div><dt>TIMEFRAME</dt><dd>{project.timeframe}</dd></div><div><dt>FOCUS</dt><dd>{project.tags.slice(0, 3).join(' / ')}</dd></div></dl><ProjectMedia project={project} /></div>
  <section class="paper-section case-body"><div class="shell case-grid"><aside class="case-aside"><span class="eyebrow">INSIDE THE PROJECT</span><nav aria-label="Case study sections"><a href="#overview">01 &nbsp; Overview</a><a href="#contribution">02 &nbsp; My contribution</a><a href="#system">03 &nbsp; Under the hood</a><a href="#considerations">04 &nbsp; Design considerations</a></nav>{project.external && <a class="text-link external-project" href={project.external.url} target="_blank" rel="noopener noreferrer">{project.external.label}<Arrow /></a>}</aside><div class="case-content">
    <section id="overview"><span class="eyebrow">01 / THE CONTEXT</span><h2>The idea behind it.</h2><p class="case-overview">{project.overview}</p></section>
    <section id="contribution"><span class="eyebrow">02 / MY CONTRIBUTION</span><h2>Connecting the pieces.</h2><div class="contributions">{project.contributions.map((item, index) => <article><span class="contribution-num">0{index + 1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></section>
    <section id="system"><span class="eyebrow">03 / UNDER THE HOOD</span><h2>A system, made legible.</h2><p>A conceptual view of the moving parts. This simplifies the project’s focus into an understandable sequence, rather than an exact deployment diagram.</p><ol class="system-flow">{project.system.map((item, index) => <li><span class="system-index">0{index + 1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div><span class="flow-arrow" aria-hidden="true">↓</span></li>)}</ol></section>
    <section id="considerations"><span class="eyebrow">04 / DESIGN CONSIDERATIONS</span><h2>The questions that matter.</h2><p>Useful systems depend on the boundaries and tradeoffs, not just their feature list.</p><div class="considerations">{project.designConsiderations.map(item => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div><div class="scope-note"><span aria-hidden="true">↳</span><p>{project.scopeNote}</p></div></section>
  </div></div></section>
  <a class="next-project shell" href={`/work/${next.slug}/`}><div><span class="eyebrow">NEXT EXPLORATION</span><h2>{next.name}</h2></div><Arrow /></a>
</BaseLayout>
