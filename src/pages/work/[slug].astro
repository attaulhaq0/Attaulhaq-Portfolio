---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import WorkflowDiagram from '../../components/WorkflowDiagram.astro';
import TechStack from '../../components/TechStack.astro';
import ConceptMotion from '../../components/ConceptMotion.astro';
import DevelopmentEvidence from '../../components/DevelopmentEvidence.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } })); }
const { project, next } = Astro.props;
const coverLabel = project.coverKind === 'gameplay' ? 'Gameplay capture' : project.coverKind === 'screenshot' ? 'Product capture' : 'Project illustration';
const hasShowcase = Boolean(project.media || project.gallery?.length);
const sectionTitles = project.sectionTitles ?? { overview: "The context.", contribution: "My contribution.", system: "The workflow.", considerations: "Design considerations." };
---
<BaseLayout title={`${project.name} — Sheikh Atta-ul-Haq`} description={project.summary}>
  <section class:list={['case-hero', 'case-hero-new', `case-theme-${project.theme}`, `case-project-${project.slug}`]} aria-labelledby="case-title">
    <div class="shell">
      <a href="/#work" class="back-link case-back-link">← Back to selected work</a>
      <div class="case-hero-grid">
        <div class="case-hero-copy">
          <div class="case-eyebrow eyebrow"><span>CASE STUDY / {project.index}</span><span>{project.category}</span></div>
          <h1 id="case-title">{project.name}<span>.</span></h1>
          <p class="case-description">{project.summary}</p>
          <dl class="case-facts">
            <div><dt>MY ROLE</dt><dd>{project.role}</dd></div>
            <div><dt>PERIOD</dt><dd>{project.year}</dd></div>
            <div><dt>FOCUS</dt><dd>{project.tags.slice(0, 3).join(' / ')}</dd></div>
          </dl>
          <div class="case-hero-actions">
            <a class="case-primary-action" href="#contribution">Explore my contribution <Arrow /></a>
            {project.external && <a class="case-external-action" href={project.external.url} target="_blank" rel="noopener noreferrer">{project.external.label}<Arrow /></a>}
            {project.conceptMotion && <a class="case-external-action" href={`#concept-motion-${project.slug}`}>Watch the animation <span aria-hidden="true">▷</span></a>}
          </div>
        </div>
        <figure class:list={['case-cover', { 'case-media': !hasShowcase }]}>
          {project.media ? <a class="case-cover-play" href="#project-media" aria-label={`Watch ${project.name} demonstration`}><img src={project.cover} alt={project.coverAlt} width="1280" height="720" fetchpriority="high" decoding="async" /><span class="case-cover-play-label"><span class="case-play-symbol" aria-hidden="true">▷</span><span>Watch the prototype<span>{project.media.durationLabel ?? 'View the demonstration'}</span></span></span></a> : <img src={project.cover} srcset={project.coverSrcSet} sizes="(max-width: 760px) calc(100vw - 48px), (max-width: 1100px) 50vw, 800px" alt={project.coverAlt} width={project.coverWidth ?? 1200} height={project.coverHeight ?? 800} fetchpriority="high" decoding="async" />}
          <figcaption><span class="case-cover-type">{coverLabel}</span><span class="case-cover-index" aria-hidden="true">/{project.index}</span></figcaption>
        </figure>
      </div>
    </div>
  </section>
  {hasShowcase && <section class="shell case-showcase" id="project-media" aria-label={`${project.name} demonstration and captures`}><div class="case-showcase-heading"><span class="eyebrow">IN THE PROJECT</span><h2>{project.media ? 'See it in action.' : 'A closer look.'}</h2></div><ProjectMedia project={project} /></section>}
  <section class="paper-section case-body"><div class="shell case-grid"><aside class="case-aside"><span class="eyebrow">INSIDE THE PROJECT</span><nav aria-label="Case study sections"><a href="#overview">01 &nbsp; Overview</a><a href="#contribution">02 &nbsp; My contribution</a><a href="#system">03 &nbsp; Under the hood</a><a href="#considerations">04 &nbsp; Design considerations</a></nav></aside><div class="case-content">
    <section id="overview"><span class="eyebrow">01 / THE CONTEXT</span><h2>{sectionTitles.overview}</h2><p class="case-overview">{project.overview}</p><TechStack projectSlug={project.slug} /></section>
    <section id="contribution"><span class="eyebrow">02 / MY CONTRIBUTION</span><h2>{sectionTitles.contribution}</h2><div class="contributions">{project.contributions.map((item, index) => <article><span class="contribution-num">0{index + 1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></section>
    <section id="system"><span class="eyebrow">03 / UNDER THE HOOD</span><h2>{sectionTitles.system}</h2><WorkflowDiagram project={project} /><DevelopmentEvidence project={project} /><ConceptMotion project={project} /></section>
    <section id="considerations"><span class="eyebrow">04 / DESIGN CONSIDERATIONS</span><h2>{sectionTitles.considerations}</h2><div class="considerations">{project.designConsiderations.map(item => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div><div class="scope-note"><span aria-hidden="true">↳</span><p>{project.scopeNote}</p></div></section>
  </div></div></section>
  <a class="next-project shell" href={`/work/${next.slug}/`}><div><span class="eyebrow">NEXT EXPLORATION</span><h2>{next.name}</h2></div><Arrow /></a>
</BaseLayout>
