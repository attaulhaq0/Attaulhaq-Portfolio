---
import { freelanceMilestone } from '../data/achievements';
import '../styles/career-highlights.css';
---

<section class="career-highlights shell" id="milestones" aria-labelledby="career-highlights-title">
  <div class="section-topline">
    <span class="eyebrow">FREELANCE MILESTONE</span>
  </div>
  <div class="career-highlights-heading">
    <h2 id="career-highlights-title">Client work.<br /><em>Delivered.</em></h2>
    <p>Software, AI and automation projects for clients across industries.</p>
  </div>

  <div class="career-highlights-grid">
    <article class="career-freelance" aria-labelledby="freelance-milestone-title">
      <div class="career-freelance-copy">
        <p class="career-milestone-meta"><span>{freelanceMilestone.platform}</span><span>{freelanceMilestone.period}</span></p>
        <h3 id="freelance-milestone-title">{freelanceMilestone.title}</h3>
        <p class="career-milestone-description">{freelanceMilestone.description}</p>
        <dl class="career-metrics">{freelanceMilestone.metrics.map(metric => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>
      </div>
      <figure class="fiverr-evidence"><a href={freelanceMilestone.image.src} target="_blank" rel="noopener noreferrer" aria-label="Open full-size Fiverr record"><img src={freelanceMilestone.image.src} alt={freelanceMilestone.image.alt} width={freelanceMilestone.image.width} height={freelanceMilestone.image.height} loading="lazy" decoding="async" /></a><figcaption>{freelanceMilestone.image.caption}</figcaption></figure>
    </article>
  </div>
</section>
