---
interface Props { mobile?: boolean }
const { mobile = false } = Astro.props;
const onWebsites = Astro.url.pathname.startsWith('/freelance-work/');
---
<details class:list={['work-nav', { 'work-nav-mobile': mobile }]} data-work-navigation>
  <summary>Work <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
  <div class="work-options">
    <a href="/#work" aria-label="Engineering projects"><strong>Engineering projects</strong><small>AI, software & interactive systems</small></a>
    <a href="/freelance-work/" aria-label="Freelance websites" aria-current={onWebsites ? (Astro.url.pathname === '/freelance-work/' ? 'page' : 'location') : undefined}><strong>Freelance websites</strong><small>Client website design & delivery</small></a>
  </div>
</details>
<style>
  .work-nav { position: relative; }
  .work-nav > summary { display: flex; align-items: center; gap: 7px; min-height: 44px; cursor: pointer; list-style: none; color: var(--foreground); font: inherit; }
  .work-nav > summary::-webkit-details-marker { display: none; }
  .work-nav > summary:hover, .work-nav[open] > summary { color: var(--accent); }
  .work-nav summary svg { flex: 0 0 auto; transition: transform .18s ease; }
  .work-nav[open] summary svg { transform: rotate(180deg); }
  .work-options { position: absolute; top: calc(100% + 8px); left: -18px; z-index: 30; width: 288px; padding: 8px; border: 1px solid var(--border-strong); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow-soft); }
  .work-options a { display: grid; gap: 5px; padding: 15px 12px; white-space: normal; border-radius: 6px; }
  .work-options a:hover, .work-options a:focus-visible { background: var(--surface-raised); }
  .work-options a::after { display: none; }
  .work-options strong { font-size: 13px; font-weight: 600; line-height: 1.4; }
  .work-options small { color: var(--muted); font-size: 12px; line-height: 1.5; }
  .work-options a[aria-current] strong { color: var(--accent); }
  .work-nav-mobile > summary { width: auto; height: auto; min-height: 48px; flex-direction: row; justify-content: space-between; align-items: center; font-size: 16px; border-bottom: 1px solid var(--border); }
  .work-nav-mobile .work-options { position: static; width: auto; padding: 4px 0 4px 12px; border: 0; border-left: 1px solid var(--border-strong); border-radius: 0; background: transparent; box-shadow: none; margin: 4px 0 8px; }
  :global(html[data-theme] .work-nav-mobile .work-options a) { padding: 12px 8px; border: 0; }
  @media (prefers-reduced-motion: reduce) { .work-nav summary svg { transition: none; } }
</style>
