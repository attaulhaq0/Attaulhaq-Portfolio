---
import Arrow from './Arrow.astro';
import { site } from '../data/site';
import '../styles/scene-journey.css';
const posterSrc = '/images/source-character-poster.webp';
---
<section class="hero spatial-hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"><span class="hero-glow"></span><span class="hero-orbit hero-orbit-one"></span><span class="hero-orbit hero-orbit-two"></span></div>
  <div class="hero-stage shell">
    <div class="hero-identity">
      <p class="hero-greeting">Hello, I’m</p>
      <h1 id="hero-title">Atta-ul-Haq</h1>
      <p class="hero-positioning">AI engineering<br />for intelligent products.</p>
      <a class="hero-work-link" href="#work">Explore my work <Arrow /></a>
    </div>
    <div class="hero-art" aria-label="A standing stylized developer character" data-scene-state="poster">
      <img class="hero-poster" src={posterSrc} width="768" height="1152" alt="A standing stylized developer character with violet eyes and a white shirt, raising an open hand in greeting." fetchpriority="high" />
      <div id="hero-canvas" class="hero-canvas" hidden></div>
      <p class="scene-status sr-only" role="status" aria-live="polite"></p>
    </div>
    <div class="hero-role">
      <p>AI engineering & product development.</p>
      <div class="role-display"><span>AI</span><span class="role-outline">Engineer</span><span class="role-lavender">Builder<span class="role-dot">.</span></span></div>
      <p class="hero-role-note">Agentic systems & RAG.<br />Product design & development.</p>
      <a class="hero-contact-link" href={site.calendly} target="_blank" rel="noopener noreferrer">Book a meeting with me <Arrow /></a>
    </div>
  </div>
  <div class="hero-foot shell"><div class="hero-socials"><a href={site.github} target="_blank" rel="noopener noreferrer">GITHUB <span aria-hidden="true">↗</span></a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LINKEDIN <span aria-hidden="true">↗</span></a></div><a href="#work" aria-label="Scroll to selected work">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
</section>
<script>
  const target = document.querySelector<HTMLDivElement>('#hero-canvas');
  const poster = document.querySelector<HTMLImageElement>('.hero-poster');
  const status = document.querySelector<HTMLElement>('.scene-status');
  const art = document.querySelector<HTMLElement>('.hero-art');
  let dispose: (() => void) | undefined;
  let controller: AbortController | undefined;
  let startup: number | undefined;
  let sceneRequest = 0;
  let pageSuspended = false;
  const journey = window.matchMedia('(min-width: 1101px) and (prefers-reduced-motion: no-preference)');
  const syncJourney = () => {
    if (!target || !art) return;
    const hero = art.closest<HTMLElement>('.spatial-hero');
    const work = document.querySelector<HTMLElement>('#work');
    if (!hero || !work || !journey.matches || art.dataset.sceneState !== 'ready') {
      target.classList.remove('scene-journey');
      target.style.removeProperty('left'); target.style.removeProperty('top'); target.style.removeProperty('width'); target.style.removeProperty('height'); target.style.removeProperty('opacity'); target.style.removeProperty('visibility'); target.style.removeProperty('pointer-events');
      target.dataset.journeyStage = 'hero';
      return;
    }
    const heroBounds = hero.getBoundingClientRect();
    const artBounds = art.getBoundingClientRect();
    const progress = Math.max(0, Math.min(1, -heroBounds.top / heroBounds.height));
    const blend = progress * progress * (3 - 2 * progress);
    const exit = Math.max(0, Math.min(1, (innerHeight * .45 - work.getBoundingClientRect().top) / (innerHeight * .30)));
    target.classList.add('scene-journey');
    target.dataset.journeyStage = exit >= 1 ? 'complete' : progress >= .95 ? 'intro' : 'hero';
    const left = artBounds.left + (Math.max(56, (innerWidth - 1400) / 2) - artBounds.left) * blend;
    const top = artBounds.top - heroBounds.top;
    const width = artBounds.width + (Math.min(440, innerWidth * .33) - artBounds.width) * blend;
    const height = artBounds.height + (Math.min(590, innerHeight * .72) - artBounds.height) * blend;
    target.style.left = `${left}px`; target.style.top = `${top}px`; target.style.width = `${width}px`; target.style.height = `${height}px`;
    target.style.opacity = `${1 - exit}`; target.style.visibility = exit >= 1 ? 'hidden' : 'visible'; target.style.pointerEvents = progress > .1 ? 'none' : 'auto';
  };
  const resetScene = () => {
    sceneRequest += 1;
    if (startup !== undefined) window.cancelAnimationFrame(startup);
    startup = undefined;
    controller?.abort();
    controller = undefined;
    dispose?.();
    dispose = undefined;
    if (target) { target.hidden = true; target.replaceChildren(); }
    if (poster) poster.style.opacity = '1';
    art?.classList.remove('scene-active');
    if (art) art.dataset.sceneState = 'poster';
    syncJourney();
  };
  const startScene = async () => {
    if (target && poster && status && art) {
      if (pageSuspended || document.hidden || dispose || controller) return;
      const request = ++sceneRequest;
      const loading = new AbortController();
      controller = loading;
      art.dataset.sceneState = 'loading';
      try {
        if (import.meta.env.DEV) await import('@vitejs/plugin-react/preamble');
        const { mountScene } = await import('../islands/mountScene');
        if (pageSuspended || loading.signal.aborted || request !== sceneRequest) return;
        const sceneContainer = document.createElement('div');
        sceneContainer.style.width = '100%';
        sceneContainer.style.height = '100%';
        target.append(sceneContainer);
        target.hidden = false;
        const unmount = await mountScene(sceneContainer, loading.signal, () => {
          if (pageSuspended || request !== sceneRequest) return;
          resetScene(); art.dataset.sceneState = 'fallback'; status.textContent = 'The character illustration remains available.';
        });
        if (pageSuspended || request !== sceneRequest) { unmount(); sceneContainer.remove(); return; }
        dispose = () => { unmount(); sceneContainer.remove(); };
        poster.style.opacity = '0'; art.classList.add('scene-active'); art.dataset.sceneState = 'ready';
        syncJourney();
      } catch {
        if (!pageSuspended && request === sceneRequest) { resetScene(); art.dataset.sceneState = 'fallback'; status.textContent = 'The character illustration remains available.'; }
      }
    }
  };
  const scheduleScene = () => {
    if (startup !== undefined || pageSuspended || document.hidden || dispose || controller) return;
    // Allow the essential HTML and static poster to paint before loading React/Three.
    startup = window.requestAnimationFrame(() => {
      startup = undefined;
      void startScene();
    });
  };
  scheduleScene();
  window.addEventListener('pagehide', () => { pageSuspended = true; resetScene(); if (art) art.dataset.sceneState = 'suspended'; if (status) status.textContent = ''; });
  window.addEventListener('pageshow', () => { pageSuspended = false; scheduleScene(); });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) scheduleScene(); });
  window.addEventListener('scroll', syncJourney, { passive: true });
  window.addEventListener('resize', syncJourney, { passive: true });
  journey.addEventListener('change', syncJourney);
</script>
<style>
  .hero-canvas { opacity: 0; transition: opacity .45s ease; }
  .scene-active .hero-canvas { opacity: 1; }
</style>
