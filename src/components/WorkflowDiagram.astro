---
import type { Project } from '../data/projects';
interface Props { project: Project }
const { project } = Astro.props;
const points = [{ x: 50, y: 15 }, { x: 84, y: 42 }, { x: 71, y: 80 }, { x: 29, y: 80 }, { x: 16, y: 42 }];
const stageArt = ['context', 'decision', 'build', 'review', 'outcome'];
---

<div class:list={['workflow-diagram', `workflow-${project.theme}`]} data-workflow>
  <div class="workflow-ring" data-workflow-ring hidden aria-label={`${project.name} workflow stages`}>
    <div class="workflow-orbit" aria-hidden="true"></div>
    <div class="workflow-center"><strong>{project.name}</strong><span>5-stage overview</span></div>
    {project.system.map((step, index) => <button type="button" class="workflow-stage" data-workflow-stage={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`system-stage-${index + 1}`} style={`--stage-x:${points[index].x}%;--stage-y:${points[index].y}%;`}><span class="workflow-stage-art"><img src={`/images/workflow/${stageArt[index]}.webp`} alt="" width="400" height="400" loading="lazy" decoding="async" /><span class="workflow-stage-number" aria-hidden="true">0{index + 1}</span></span><span class="workflow-stage-title">{step.title}</span></button>)}
    <p class="workflow-ring-instruction">Select a stage to explore.</p>
  </div>
  <ol class="system-flow workflow-details" aria-live="polite" aria-atomic="true">
    {project.system.map((step, index) => <li id={`system-stage-${index + 1}`} data-workflow-detail><span class="system-index">0{index + 1}</span><div><span class="workflow-detail-eyebrow">STAGE {index + 1} OF {project.system.length}</span><h3>{step.title}</h3><p>{step.body}</p></div></li>)}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-workflow]').forEach(diagram => {
    const ring = diagram.querySelector<HTMLElement>('[data-workflow-ring]');
    const buttons = Array.from(diagram.querySelectorAll<HTMLButtonElement>('[data-workflow-stage]'));
    const details = Array.from(diagram.querySelectorAll<HTMLElement>('[data-workflow-detail]'));
    if (!ring || buttons.length !== details.length || !buttons.length) return;
    const select = (index: number, updateUrl = true) => {
      buttons.forEach((button, position) => button.setAttribute('aria-pressed', String(position === index)));
      details.forEach((detail, position) => { detail.hidden = position !== index; });
      if (updateUrl) history.replaceState(history.state, '', `#system-stage-${index + 1}`);
    };
    const readHash = () => {
      const match = location.hash.match(/^#system-stage-(\d+)$/);
      if (match && Number(match[1]) >= 1 && Number(match[1]) <= details.length) select(Number(match[1]) - 1, false);
    };
    const click = (event: Event) => select(Number((event.currentTarget as HTMLButtonElement).dataset.workflowStage));
    const key = (event: KeyboardEvent) => {
      const index = buttons.indexOf(event.currentTarget as HTMLButtonElement);
      const next = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? Math.min(index + 1, buttons.length - 1) : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? Math.max(index - 1, 0) : event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : undefined;
      if (next === undefined) return;
      event.preventDefault();
      select(next);
      buttons[next].focus();
    };
    let attached = false;
    const attach = () => {
      if (attached) return;
      attached = true;
      buttons.forEach(button => { button.addEventListener('click', click); button.addEventListener('keydown', key); });
      window.addEventListener('hashchange', readHash);
    };
    const detach = () => {
      attached = false;
      buttons.forEach(button => { button.removeEventListener('click', click); button.removeEventListener('keydown', key); });
      window.removeEventListener('hashchange', readHash);
    };
    diagram.classList.add('workflow-enhanced');
    ring.hidden = false;
    select(0, false);
    readHash();
    attach();
    window.addEventListener('pagehide', detach);
    window.addEventListener('pageshow', attach);
  });
</script>
