---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
---

<BaseLayout title="Credits — Sheikh Atta-ul-Haq" description="Credits for the decorative avatar, site artwork, open-source tools and typefaces used in this portfolio.">
  <section class="credits-page shell" aria-labelledby="credits-title">
    <a class="back-link" href="/">← Back to the portfolio</a>
    <div class="credits-heading">
      <span class="eyebrow">THE PEOPLE & TOOLS BEHIND THE SITE</span>
      <h1 id="credits-title">Credits<span class="mint">.</span></h1>
      <p>A few acknowledgements for the work that helps bring this portfolio to life.</p>
    </div>
    <div class="credits-list">
      <article>
        <h2>Decorative avatar</h2>
        <div>
          <p>The original 3D avatar is by <a href="https://www.moncy.dev/" target="_blank" rel="noopener noreferrer">Moncy Yohannan <Arrow /></a>. The model and the poster rendered from it are used in this portfolio with designer permission confirmed by the portfolio owner.</p>
          <p>The character is decorative. Its standing pose and scroll integration were authored for this site.</p>
        </div>
      </article>
      <article>
        <h2>Site & artwork</h2>
        <div>
          <p>This portfolio was developed with AI assistance. Original site code and artwork are all rights reserved unless separately licensed. Project media and third-party assets retain their respective ownership.</p>
        </div>
      </article>
      <article>
        <h2>Tools & type</h2>
        <div>
          <p>Built with Astro, React, React Three Fiber and Three.js. These open-source projects retain their respective licenses.</p>
          <p>Manrope and Source Sans 3 are self-hosted through Fontsource under the SIL Open Font License 1.1.</p>
          <div class="credits-licenses"><a href="/licenses/manrope-OFL.txt">Manrope license <Arrow /></a><a href="/licenses/source-sans-3-OFL.txt">Source Sans 3 license <Arrow /></a></div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body:has(.credits-page) .header) { position: relative; }
  .credits-page { padding-block: 24px 88px; }
  .credits-heading { max-width: 700px; margin-top: 44px; }
  .credits-heading .eyebrow { color: var(--mint); font-size: 11px; }
  .credits-heading h1 { font-size: clamp(48px, 6vw, 80px); line-height: 1.12; letter-spacing: -.055em; margin-block: 16px 20px; }
  .credits-heading > p { color: var(--muted); font-size: 20px; max-width: 560px; }
  .credits-list { max-width: 1100px; margin-top: 52px; }
  .credits-list article { display: grid; grid-template-columns: minmax(180px, .7fr) minmax(0, 1.5fr); gap: 48px; border-top: 1px solid var(--line); padding-block: 28px; }
  .credits-list h2 { font-size: 24px; line-height: 1.35; letter-spacing: -.035em; }
  .credits-list p { color: var(--muted); font-size: 17px; line-height: 1.7; }
  .credits-list p + p { margin-top: 12px; }
  .credits-list a { color: var(--paper); text-decoration: underline; text-decoration-color: var(--mint); text-underline-offset: 5px; }
  .credits-list a:hover { color: var(--mint); }
  .credits-list .arrow { width: 13px; margin-left: 4px; }
  .credits-licenses { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 12px; font-size: 14px; }
  .credits-licenses a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 760px) {
    .credits-page { padding-block: 12px 52px; }
    .credits-heading { margin-top: 30px; }
    .credits-heading > p { font-size: 18px; }
    .credits-list { margin-top: 36px; }
    .credits-list article { grid-template-columns: 1fr; gap: 14px; padding-block: 24px; }
    .credits-list h2 { font-size: 22px; }
    .credits-list p { font-size: 16px; }
  }
</style>
