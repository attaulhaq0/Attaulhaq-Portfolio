---
import { clientWebsites } from '../data/client-work';
import Arrow from './Arrow.astro';
import '../styles/client-work.css';
---
<section class="client-work-section" id="freelance-web-development" aria-label="Freelance website projects">
  <div class="shell">
    <nav class="client-project-index" aria-label="Jump to a client website">
      <ol>{clientWebsites.map((website, index) => <li><a href={`#${website.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{website.name}</a></li>)}</ol>
    </nav>
    <div class="client-work-grid">
      {clientWebsites.map((website, index) => <article id={website.id} class="client-website" aria-labelledby={`client-${website.id}-title`}>
        <header class="client-website-heading">
          <div><p class="client-website-role">{String(index + 1).padStart(2, '0')} / {website.category}</p><h2 id={`client-${website.id}-title`}>{website.name}</h2></div>
          <p class="client-website-need">{website.need}</p>
        </header>
        <div class="client-website-body">
          <figure class="client-website-preview">
            <video class="client-website-motion" style={`aspect-ratio: ${website.motion.width} / ${website.motion.height}`} controls muted loop playsinline preload="none" poster={website.motion.poster} width={website.motion.width} height={website.motion.height} aria-label={`${website.name} website motion and interaction preview`}>
              <source src={website.motion.src} type="video/mp4" />
              Your browser does not support video. <a href={website.motion.src}>Watch the website preview</a>.
            </video>
            <figcaption><span>Play preview · {website.motion.duration}s · silent</span><p>{website.motion.caption}</p></figcaption>
          </figure>
          <div class="client-website-copy">
            <h3>My contribution</h3><p>{website.contribution}</p>
            <h3>Design decision</h3><p>{website.decision}</p>
            <h3>Implementation</h3><p class="client-website-runtime">{website.runtime}</p>
            <ul class="client-website-stack" aria-label={`${website.name} technologies`}>{website.stack.map(tool => <li>{tool}</li>)}</ul>
            <div class="client-website-actions">
            {website.caseStudyUrl && <a href={website.caseStudyUrl} aria-label={`Read ${website.name} case study`}>Read case study <Arrow /></a>}
              <a href={website.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${website.name} website`}>View website <Arrow /></a>
              <a href={website.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${website.name} code`}>View code <Arrow /></a>
            </div>
          </div>
        </div>
        <details class="client-website-details">
          <summary>Selected views & build details <span aria-hidden="true">+</span></summary>
          <div class="client-selected-views">
            <figure><a href={website.image} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${website.name} desktop and mobile preview`}><img src={website.image} alt={website.imageAlt} width="1600" height="1120" loading="lazy" decoding="async" /></a><figcaption><strong>Across screen sizes</strong>{website.responsiveCaption}</figcaption></figure>
            <figure><a href={website.detail.image} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${website.name} supporting page view`}><img src={website.detail.image} alt={website.detail.alt} width={website.detail.width} height={website.detail.height} loading="lazy" decoding="async" /></a><figcaption><strong>{website.detail.title}</strong>{website.detail.caption}</figcaption></figure>
          </div>
          {website.fullHomepage?.previewCaption && <figure class="client-complete-homepage">
            <figcaption><strong>Complete homepage</strong><p>{website.fullHomepage.previewCaption}</p><a href={website.fullHomepage.image} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${website.name} complete homepage`}>Open full-size view <Arrow /></a></figcaption>
            <a class="client-complete-homepage-image" href={website.fullHomepage.image} target="_blank" rel="noopener noreferrer" aria-label={`Inspect ${website.name} complete homepage`}><img src={website.fullHomepage.image} alt={website.fullHomepage.imageAlt} width={website.fullHomepage.width} height={website.fullHomepage.height} loading="lazy" decoding="async" /></a>
          </figure>}
          {website.interactionMotion && <figure class="client-website-preview client-website-interaction">
            <video class="client-website-motion" style={`aspect-ratio: ${website.interactionMotion.width} / ${website.interactionMotion.height}`} controls muted loop playsinline preload="none" poster={website.interactionMotion.poster} width={website.interactionMotion.width} height={website.interactionMotion.height} aria-label={`${website.name} creative-work carousel preview`}>
              <source src={website.interactionMotion.src} type="video/mp4" />
              Your browser does not support video. <a href={website.interactionMotion.src}>Watch the carousel preview</a>.
            </video>
            <figcaption><span>Creative-work interaction · {website.interactionMotion.duration}s · silent</span><p>{website.interactionMotion.caption}</p></figcaption>
          </figure>}
          <div class="client-website-evidence">
            <div><h3>Build scope</h3><ul>{website.evidence.map(item => <li>{item}</li>)}</ul></div>
            <div><h3>Source & setup</h3><p>{website.boundary}</p><a href={website.setupUrl} target="_blank" rel="noopener noreferrer">{website.setupLabel ?? 'Server setup guide'} <Arrow /></a>{website.fullHomepage && <a href={website.fullHomepage.image} target="_blank" rel="noopener noreferrer" aria-label={`View full ${website.name} homepage`}>View complete homepage capture <Arrow /></a>}</div>
          </div>
        </details>
      </article>)}
    </div>
    <div class="client-work-next"><a href="/#work">Explore my engineering projects <Arrow /></a><a href="/#contact">Discuss a website <Arrow /></a></div>
    <a class="client-work-source-index" href="https://github.com/attaulhaq0/website-work" target="_blank" rel="noopener noreferrer">Website source collection on GitHub <Arrow /></a>
  </div>
</section>
<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.client-website-motion')];
  videos.forEach(video => {
    const pause = () => video.pause();
    const visibility = () => { if (document.hidden) pause(); };
    video.addEventListener('play', () => videos.forEach(other => { if (other !== video) other.pause(); }));
    const observer = new IntersectionObserver(entries => { if (!entries[0]?.isIntersecting) pause(); });
    const attach = () => { document.addEventListener('visibilitychange', visibility); observer.observe(video); };
    const detach = () => { pause(); document.removeEventListener('visibilitychange', visibility); observer.disconnect(); };
    attach();
    window.addEventListener('pagehide', detach);
    window.addEventListener('pageshow', attach);
  });
</script>
